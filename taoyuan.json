    "url": "http://www.zzgs.org.cn/search?searchkey=%@",
    "method": "GET",
    "httpRefer": "http://www.zzgs.org.cn",
    "maxPage": 5,
    "responseList": "div[@class=result-item]",
    "responseName": "div[@class=result-item-title].a.text()",
    "responseAuthor": "div[@class=result-item-title].span.text()",
    "responseCover": "img.@src",
    "responseIntro": "div[@class=result-item-desc].text()",
    "responseSource": {
      "catalogUrl": "div[@class=result-item-title].a.@href"
    }
  },
  "catalog": {
    "url": "",
    "method": "GET",
    "maxPage": 1,
    "responseList": "dd",
