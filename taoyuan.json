{
  "name": "桃鸢书院",
  "host": "http://www.zzgs.org.cn",
  "group": "小说",
  "weight": 66,
  "enabled": true,
  "enabledCookies": true,
  "search": {
    "url": "http://www.zzgs.org.cn/search?searchkey=%@",
    "parser": {
      "_list": "div[@class=result-list].div[@class=result-item]",
      "title": "div[@class=result-item-title].a[0]",
      "author": ["div[@class=result-item-title].span[0]", "@str:replace(作者：,)"],
      "cover": "a[@class=result-item-cover].img[0].@src",
      "intro": "p[@class=result-item-desc][0]",
      "url": "div[@class=result-item-title].a[0].@href"
    }
  },
  "detail": {
    "parser": {
      "title": "h1[0]",
      "author": "a[href*=author][0]",
      "cover": "img[0].@src",
      "intro": "p[0]",
      "catalog": "a[href*=index][0].@href",
      "lastChapter": "dd[-1].a[0]"
    }
  },
  "catalog": {
    "parser": {
      "_list": "dd",
      "title": "a[0]",
      "url": "a[0].@href"
    }
  },
  "chapter": {
    "parser": {
      "content": ["div[@id=chaptercontent][0].@html", "@str:regex(最新.*?小说：.*,)", "@str:regex(相关推荐：.*,)", "@str:regex(本站.*?转码.*,)", "@str:regex(章节报错.*,)", "@str:regex(返回顶部,)"],
      "nextPage": "a[text()=下一页][0].@href"
    }
  },
  "shupai": [
    {
      "name": "玄幻小说",
      "url": "http://www.zzgs.org.cn/sort/xuanhuan/%@calc(pageIndex+1)",
