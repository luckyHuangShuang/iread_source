  "chapter": {
    "url": "",
    "method": "GET",
    "responseContent": "div[@id=chaptercontent].html()",
    "responsePurify": "最新.*?小说：.*|相关推荐：.*|本站.*?转码.*|章节报错.*|返回顶部",
    "nextPage": "a[contains(text(),'下一页')].@href"
  },
  "detail": {
    "url": "",
    "method": "GET",
    "responseName": "h1.text()",
    "responseAuthor": "a[contains(@href,'author')].text()",
